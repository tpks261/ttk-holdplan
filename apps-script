    .split(',')
    .map(x => Number(String(x).trim()))
    .filter(n => !isNaN(n) && n >= 1 && n <= 42);
}

function calculateAgeFromDanishDate_(dateStr) {
  if (!dateStr) return '';

  const cleaned = String(dateStr).trim();
  const parts = cleaned.split(/[\/.-]/).map(x => String(x || '').trim());

  if (parts.length !== 3) return '';

  const day = Number(parts[0]);
  const month = Number(parts[1]) - 1;
  let year = Number(parts[2]);

  if (isNaN(day) || isNaN(month) || isNaN(year)) return '';
  if (year < 100) year += year > 30 ? 1900 : 2000;

  const birth = new Date(year, month, day);
  if (
    isNaN(birth.getTime()) ||
    birth.getFullYear() !== year ||
    birth.getMonth() !== month ||
    birth.getDate() !== day
  ) return '';

  const today = new Date();

  let age = today.getFullYear() - birth.getFullYear();

  const hasHadBirthday =
    today.getMonth() > birth.getMonth() ||
    (today.getMonth() === birth.getMonth() && today.getDate() >= birth.getDate());

  if (!hasHadBirthday) age--;

  return age;
}

function normalizeTimer_(value) {
  const s = String(value || '').trim();
  const n = Number(s.replace(',', '.'));

  if (!isNaN(n) && n > 0) return n;

  const lower = s.toLowerCase();

  if (lower.includes('4')) return 4;
  if (lower.includes('3')) return 3;
  if (lower.includes('2')) return 2;

  return 1;
}

function normalizePrice_(value) {
  const s = String(value || '').replace(/[^\d]/g, '');
  const n = Number(s);

  return isNaN(n) ? 0 : n;
}

function inferTimerFromRowsBeforeHeader_(rows, headerRowIndex) {
  let text = '';

  for (let i = 0; i < headerRowIndex; i++) {
    text += ' ' + rows[i].map(cell => String(cell || '')).join(' ');
  }

  return inferTimerFromText_(text, '', '');
}

function inferTimerFromText_(productText, meddelelse, timerText) {
  const txt = `${productText} ${meddelelse} ${timerText || ''}`.toLowerCase();

  if (
    txt.includes('4 gange') ||
    txt.includes('4 timer') ||
    txt.includes('4 time') ||
    txt.includes('4x') ||
    txt.includes('4 x') ||
    txt.includes('fire gange') ||
    txt.includes('fire timer') ||
    txt.includes('fire x')
  ) return 4;

  if (
    txt.includes('3 gange') ||
    txt.includes('3 timer') ||
    txt.includes('3 time') ||
    txt.includes('3x') ||
    txt.includes('3 x') ||
    txt.includes('tre gange') ||
    txt.includes('tre timer') ||
    txt.includes('tre x')
  ) return 3;

  if (
    txt.includes('2 gange') ||
    txt.includes('2 timer') ||
    txt.includes('2 time') ||
    txt.includes('2x') ||
    txt.includes('2 x') ||
    txt.includes('to gange') ||
    txt.includes('to timer') ||
    txt.includes('to x')
  ) return 2;

  return 1;
}

function inferPriceFromTimer_(t) {
  if (t === 4) return 1300;
  if (t === 3) return 1100;
  if (t === 2) return 900;

  return 600;
}

function findHeaderIndex_(header, candidates) {
  const normalizedCandidates = candidates.map(c => String(c).trim().toLowerCase());

  for (let i = 0; i < header.length; i++) {
    const h = String(header[i] || '').trim().toLowerCase();
    if (normalizedCandidates.includes(h)) return i;
  }

  return -1;
}

// Settings are additive Script Properties, scoped by season. Reading never seeds or rewrites sheets.
function readAdminSettings_(season) {
  const raw = PropertiesService.getScriptProperties().getProperty('TTK_ADMIN_SETTINGS_' + normalizeSeason_(season));
  if (!raw) return { version: 0, holds: {} };
  const value = JSON.parse(raw);
  if (!value || !value.holds || !Number.isInteger(value.version)) throw new Error('Ugyldige holdindstillinger. Kontakt admin.');
  return value;
}

function withAdminLock_(work) {
  const lock = LockService.getScriptLock();
  lock.waitLock(30000);
  try { return work(); } finally { lock.releaseLock(); }
}

function adminNameKey_(value) { return String(value || '').normalize('NFC').trim().toLowerCase().replace(/\s+/g, ' '); }

function adminCapacity_(season, hold) {
  const value = readAdminSettings_(season).holds[String(hold)];
  if (value) return value.capacity;
  return normalizeSeason_(season) === 'winter' ? 4 : 6;
}

function adminGroupCapacity_(ss, names, hold) {
  return getCandidateHoldsForBase_(ss, hold, names.extraHolds)
    .reduce((total, id) => total + adminCapacity_(names.season, id), 0);
}

function handleExtraHoldToggle_(payload) {
  return withAdminLock_(function () {
    const ss = SpreadsheetApp.getActiveSpreadsheet(), names = sheetNamesFor_(payload.season);
    if (!payload.active) {
      const sheet = ss.getSheetByName(names.assignments);
      const rows = sheet ? sheet.getDataRange().getValues().slice(1) : [];
      if (rows.some(row => parseHoldsList_(row[1]).includes(String(payload.hold)))) throw new Error('Flyt spillerne før ekstraholdet deaktiveres');
      const count = rows.filter(row => parseHoldsList_(row[1]).some(h => baseHold_(h) === baseHold_(payload.hold))).length;
      const active = getActiveExtraHolds_(ss, names.extraHolds).includes(String(payload.hold));
      const remaining = adminGroupCapacity_(ss, names, payload.hold) - (active ? adminCapacity_(names.season, payload.hold) : 0);
      if (count > remaining) throw new Error('Grundholdet har brug for ekstraholdets pladser');
    }
    return writeExtraHoldToggle_(payload);
  });
}

function handleAdminSettingsSave_(payload) {
  const expected = PropertiesService.getScriptProperties().getProperty('TTK_BACKEND_TOKEN');
  if (!expected || payload.token !== expected) throw new Error('Unauthorized settings write');
  if (!['summer', 'winter'].includes(payload.season)) throw new Error('Invalid season');
  return withAdminLock_(function () {
    const id = String(payload.holdId || '');
    const base = ADMIN_DEFAULT_SCHEDULES_[payload.season].find(h => h.id === String(Math.floor(Number(id))));
    const ss = SpreadsheetApp.getActiveSpreadsheet(), names = sheetNamesFor_(payload.season);
    if (!base || (id !== base.id && !getActiveExtraHolds_(ss, names.extraHolds).includes(id))) throw new Error('Ukendt hold');
    const capacity = Number(payload.capacity), court = String(payload.court || '').trim();
    if (!Number.isInteger(capacity) || capacity < 1 || capacity > 100 || !court || court.length > 100) throw new Error('Angiv bane og et gyldigt antal spillere');
    const settings = readAdminSettings_(payload.season);
    if (settings.version !== payload.expectedVersion) throw new Error('Indstillingerne er ændret af en anden. Genindlæs.');
    settings.holds[id] = { court: court, capacity: capacity };
    settings.version++;
    PropertiesService.getScriptProperties().setProperty('TTK_ADMIN_SETTINGS_' + payload.season, JSON.stringify(settings));
    return jsonOut_({ ok: true, adminSettings: settings });
  });
}

function handleAssignmentSave_(payload) {
  const error = writeAuthError_(payload);
  if (error) return jsonOut_({ ok: false, error: error });
  return withAdminLock_(function () {
    // Legacy summer clients do not send expectedHolds. Their existing behavior remains intact.
    if (typeof payload.expectedHolds === 'string') {
      const ss = SpreadsheetApp.getActiveSpreadsheet(), names = sheetNamesFor_(payload.season);
      const ps = ss.getSheetByName(names.players), as = ss.getSheetByName(names.assignments);
      if (!ps || !as) throw new Error('Sæsonens data findes ikke');
      const player = ps.getDataRange().getValues().slice(1).find(r => String(r[0]).trim() === (payload.playerName || payload.name));
      if (!player) throw new Error('Spilleren findes ikke');
      const rows = as.getDataRange().getValues().slice(1);
      const row = rows.find(r => String(r[0]).trim() === payload.name);
      const parse = value => String(value || '').split(/[;,]/).map(v => v.trim()).filter(Boolean);
      const before = parse(row && row[1]), next = parse(payload.holds);
      const comparable = values => values.slice().sort().join(',');
      if (comparable(before) !== comparable(parse(payload.expectedHolds))) throw new Error('Tildelingen er ændret. Genindlæs.');
      if (new Set(next).size !== next.length) throw new Error('Dubleret hold');
      const added = next.filter(id => !before.includes(id));
      if (added.length && next.length > Math.max(1, Number(player[1]) || 1)) throw new Error('For mange hold til spilleren');
      const extras = getActiveExtraHolds_(ss, names.extraHolds);
      added.forEach(id => {
        const base = ADMIN_DEFAULT_SCHEDULES_[names.season].find(h => h.id === String(Math.floor(Number(id))));
        if (!base || (id !== base.id && !extras.includes(id))) throw new Error('Ukendt hold');
        if (next.some(other => other !== id && Math.floor(Number(other)) === Number(base.id))) throw new Error('Grundholdet er allerede valgt');
        const occupied = rows.filter(r => String(r[0]).trim() !== payload.name && parse(r[1]).some(h => baseHold_(h) === baseHold_(id))).length;
        if (occupied >= adminGroupCapacity_(ss, names, id)) throw new Error('Holdet er fyldt');
      });
    }
    return writeAssignmentRow_(payload);
  });
}

function parseAdminCsv_(text) {
  let best = null, width = 0;
  [';', ',', '\t'].forEach(delimiter => {
    try {
      const rows = Utilities.parseCsv(String(text).replace(/^\uFEFF/, ''), delimiter);
      const header = rows.find(row => row.some(cell => ['navn', 'name'].includes(adminNameKey_(cell))));
      if (header && header.length > width) { best = rows; width = header.length; }
    } catch (_) { /* Try the next delimiter. */ }
  });
  if (!best) throw new Error('Kunne ikke finde Navn/Name. Kontrollér CSV-filens kolonneoverskrifter.');
  return best;
}

